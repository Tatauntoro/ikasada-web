# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# kecuali template — ini memang harus ikut ter-commit
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated
/src/generated/prisma

# upload lokal (runtime, bukan bagian repo)
public/uploads

# berkas arsip: hanya untuk dev, sengaja di luar public/ supaya tidak disajikan
# statis (unduh wajib lewat API yang memeriksa sesi alumni)
/storage

# large source assets (optimized outputs live in /public)
/_assets
/video-asset

# config opencode pribadi (memory/instructions lokal)
/opencode.json

# tooling internal — dibiarkan di root agar tool bisa menemukannya; lokal saja
/.agents
/.claude
/.continue
/.hermes
/skills-lock.json
/AGENTS.md
/CLAUDE.md

# dokumen internal/arsip perencanaan — dipindah ke docs/internal, tidak dipush
/docs/internal

# referensi desain (hanya lokal, tidak dipakai kode)
/augen
